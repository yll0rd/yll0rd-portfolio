	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint .",
		"export": "next export",
		"deploy": "next build && touch out/.nojekyll && git add out/ && git commit -m \"Deploy to gh-pages\" && git subtree push --prefix out origin gh-pages",
		"clean": "rm -rf .next out",
		"build:gh-pages": "npm run clean && npm run build",
		"db:format": "node scripts/prisma.mjs format",
		"db:generate": "node scripts/prisma.mjs generate",
		"db:push": "node scripts/prisma.mjs db push",
		"db:seed": "tsx prisma/seed.ts",
		"postinstall": "prisma generate",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
