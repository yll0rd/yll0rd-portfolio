DISCORD_SERVER_URL=your-discord_webhook_url_here
# Dashboard (server-only; never prefix these with NEXT_PUBLIC_)
DATABASE_URL="mongodb+srv://USER:PASSWORD@HOST/portfolio?retryWrites=true&w=majority"
APP_URL="http://localhost:3000"
ADMIN_USERNAME=""
ADMIN_PASSWORD=""

# Reader comments: Google sign-in via Better Auth (server-only)
# Generate a secret with: npx @better-auth/cli secret  (or any 32+ random chars)
BETTER_AUTH_SECRET=""
# Public site origin, e.g. http://localhost:3000 locally or https://yll0rd.me
BETTER_AUTH_URL="http://localhost:3000"
# Google Cloud console → APIs & Services → Credentials → OAuth client (Web).
# Authorized redirect URI: <BETTER_AUTH_URL>/api/reader-auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# New-comment email notifications via Resend (server-only; optional)
RESEND_API_KEY=""
# Where notifications are sent
COMMENT_NOTIFY_TO=""
# Must use a domain verified in Resend; onboarding@resend.dev only delivers to your own Resend account email
COMMENT_NOTIFY_FROM="Comments <onboarding@resend.dev>"
